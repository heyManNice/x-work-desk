{
    "name": "xworkd-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "prebuild": "node ../tools/check-versions.mjs",
        "build:main": "tsc -p electron/tsconfig.json",
        "watch:main": "tsc -p electron/tsconfig.json -w",
        "dev": "vite",
        "build": "npm run build:main && vite build",
        "preview": "vite preview",
        "desktop": "npm run build && electron .",
        "dist:win": "npm run build && electron-builder --win msi"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/ssh2": "^1.15.6",
        "electron": "^44.2.0",
        "electron-builder": "^26.15.3",
        "typescript": "^5.6.0",
        "vite": "^5.4.0",
        "vite-plugin-solid": "^2.11.14"
    },
    "main": "dist-electron/main.cjs",
    "description": "XWorkDesk 远程桌面客户端（连接 xworkd 服务器）",
    "author": "heyManNice <heyManNice@users.noreply.github.com>",
    "homepage": "https://github.com/heyManNice/x-work-desk",
    "build": {
        "appId": "io.github.heymannice.xworkdesk",
        "productName": "XWorkDesk",
        "directories": {
            "output": "release",
            "buildResources": "build-resources"
        },
        "files": [
            "dist/**",
            "dist-electron/**",
            "package.json",
            "server-bundle/**"
        ],
        "win": {
            "target": [
                "msi"
            ],
            "artifactName": "XWorkDesk-${version}-${arch}.${ext}"
        }
    },
    "allowScripts": {
        "electron@44.2.0": true
    },
    "dependencies": {
        "@automann/maple-mono-cn": "^7.9.2",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "lucide-solid": "^1.42.0",
        "solid-js": "^1.9.15",
        "ssh2": "^1.17.0"
    }
}