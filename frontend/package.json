{
    "name": "xworkd-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "desktop": "vite build && electron .",
        "dist:win": "vite build && electron-builder --win msi"
    },
    "devDependencies": {
        "@types/ssh2": "^1.15.6",
        "electron": "^44.2.0",
        "electron-builder": "^26.15.3",
        "typescript": "^5.6.0",
        "vite": "^5.4.0",
        "vite-plugin-solid": "^2.11.14"
    },
    "main": "electron/main.cjs",
    "description": "XWorkDesk 远程桌面客户端（连接 xworkd 服务器）",
    "author": "heyManNice <heyManNice@users.noreply.github.com>",
    "build": {
        "appId": "io.github.heymannice.xworkdesk",
        "productName": "XWorkDesk",
        "directories": {
            "output": "release",
            "buildResources": "build-resources"
        },
        "files": [
            "dist/**",
            "electron/**",
            "package.json",
            "server-bundle/**"
        ],
        "win": {
            "target": [
                {
                    "target": "msi",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "XWorkDesk-${version}-${arch}.${ext}"
        }
    },
    "allowScripts": {
        "electron@44.2.0": true
    },
    "dependencies": {
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "lucide-solid": "^1.42.0",
        "solid-js": "^1.9.15",
        "ssh2": "^1.17.0"
    }
}
